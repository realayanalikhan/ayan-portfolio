---
import { getCollection, getEntry } from "astro:content";
import { site } from "../data/site";
import DevNote from "./DevNote.astro";
import Icon from "./Icon.astro";
import MediaCard from "./MediaCard.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  number: string;
}

const { number } = Astro.props;
const role = await getEntry("experience", "content-creator");
const items = (await getCollection("creative")).sort(
  (a, b) => a.data.order - b.data.order,
);

const channels = [
  site.channels.youtube && { label: "YouTube", href: site.channels.youtube },
  site.channels.instagram && {
    label: "Instagram",
    href: site.channels.instagram,
  },
].filter(Boolean) as { label: string; href: string }[];

const workflow = [
  "Research",
  "Script",
  "Film",
  "Edit",
  "Subtitles & graphics",
  "Review",
  "Publish",
];
---

<section class="section wrap" aria-labelledby="content">
  <SectionHeading
    id="content"
    number={number}
    title="Content & video"
    intro="Alongside software, I make video: professionally at Edvoy, and on my own YouTube vlog series (Hindi, with English subtitles) and Instagram Reels, which I film, present and edit."
  />

  <div class="grid">
    {role && (
      <article class="block" aria-labelledby="edvoy-title">
        <h3 id="edvoy-title">
          {role.data.role}
          {role.data.organisation && (
            <span class="org">, {role.data.organisation}</span>
          )}
        </h3>
        <dl class="facts mono">
          <div>
            <dt class="label">Period</dt>
            <dd>{role.data.period}</dd>
          </div>
          <div>
            <dt class="label">Output</dt>
            <dd>75+ reels</dd>
          </div>
          <div>
            <dt class="label">Platforms</dt>
            <dd>Instagram · YouTube Shorts · Facebook Reels · Snapchat</dd>
          </div>
        </dl>
        <p class="text">{role.data.summary}</p>
        <ul class="list">
          {role.data.highlights.slice(1).map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    )}

    <div class="block workflow">
      <h3>Production workflow</h3>
      <ol class="steps mono">
        {workflow.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p class="text">
        I use AI tools for research, transcription, subtitles and parts of
        post-production, inside a workflow I direct. Every edit is reviewed, and
        corrected where needed, before it is published.
      </p>
      {channels.length > 0 && (
        <ul class="channel-links">
          {channels.map((channel) => (
            <li>
              <a
                class="text-link"
                href={channel.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {channel.label}
                <Icon name="arrow-up-right" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  {items.length > 0 ? (
    <ul class="media-grid" aria-label="Selected videos">
      {items.map((item) => (
        <MediaCard item={item} />
      ))}
    </ul>
  ) : (
    <DevNote text="channel links (src/data/site.ts) and 4–8 video/Reel thumbnails (src/content/creative.yaml)" />
  )}
</section>

<style>
  .grid {
    display: grid;
    gap: 2rem;
  }

  .block {
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule-strong);
  }

  .block h3 {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem);
    font-weight: 620;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .org {
    color: var(--muted);
    font-weight: 500;
  }

  .facts {
    display: grid;
    gap: 0.4rem;
    margin: 0.9rem 0;
  }

  .facts div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
  }

  .facts dd {
    margin: 0;
    color: var(--ink-2);
  }

  .text {
    max-width: 58ch;
    margin-top: 0.75rem;
    color: var(--ink-2);
  }

  .list {
    max-width: 58ch;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .list li {
    position: relative;
    padding-left: 1.1rem;
  }

  .list li + li {
    margin-top: 0.3rem;
  }

  .list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 1px;
    background: var(--accent);
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink-2);
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero) " ";
    color: var(--accent);
  }

  .channel-links {
    display: flex;
    gap: 1.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .media-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
    }

    .media-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
