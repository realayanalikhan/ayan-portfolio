---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";

/** Thumbnail linking out to the video. No embedded player. */
interface Props {
  item: CollectionEntry<"creative">;
}

const { item } = Astro.props;
const { title, platform, kind, url, thumbnail, alt, year } = item.data;
const vertical = kind !== "vlog";
const platformLabel = {
  youtube: "YouTube",
  instagram: "Instagram",
  other: "Video",
}[platform];
---

<li class:list={["media", vertical ? "vertical" : "landscape"]}>
  <a href={url} target="_blank" rel="noopener noreferrer">
    <Picture
      src={thumbnail}
      alt={alt}
      formats={["avif", "webp"]}
      widths={vertical ? [240, 360, 480] : [480, 720, 960]}
      sizes={
        vertical
          ? "(min-width: 64rem) 12rem, 45vw"
          : "(min-width: 64rem) 24rem, 90vw"
      }
      loading="lazy"
      decoding="async"
    />
    <span class="caption">
      <span class="label">
        {platformLabel} · {kind} · {year}
      </span>
      <span class="title">
        {title}
        <Icon name="arrow-up-right" />
        <span class="sr-only">(opens {platformLabel} in a new tab)</span>
      </span>
    </span>
  </a>
</li>

<style>
  .media a {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
  }

  .media :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color var(--fast) var(--ease);
  }

  .vertical :global(img) {
    aspect-ratio: 9 / 16;
  }

  .landscape :global(img) {
    aspect-ratio: 16 / 9;
  }

  .media a:hover :global(img) {
    border-color: var(--rule-strong);
  }

  .caption {
    display: grid;
    gap: 0.2rem;
  }

  .title {
    display: inline-flex;
    gap: 0.35rem;
    align-items: baseline;
    font-size: 0.9375rem;
    font-weight: 560;
    line-height: 1.3;
  }

  .media a:hover .title {
    color: var(--accent);
  }
</style>
