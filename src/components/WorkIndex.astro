---
import { getCollection } from "astro:content";
import CompactEntry from "./CompactEntry.astro";
import SectionHeading from "./SectionHeading.astro";
import WorkRow from "./WorkRow.astro";

interface Props {
  number: string;
}

const { number } = Astro.props;
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);

const featured = projects.filter((p) => p.data.kind === "case-study");
const professional = projects.filter((p) => p.data.kind === "compact");
---

<section class="section section--work wrap" aria-labelledby="work">
  <SectionHeading
    id="work"
    number={number}
    title="Selected work"
    intro="MSc research on large language models, followed by professional client work. Client entries are described at a high level for confidentiality."
  />

  {featured.map((project) => (
    <WorkRow project={project} index={projects.indexOf(project) + 1} />
  ))}

  {professional.length > 0 && (
    <div class="group">
      <h3 class="group-title">
        <span class="name">Professional work</span>
        <span class="label">
          Software Developer · 2026 · Client details confidential
        </span>
      </h3>
      <ol class="index">
        {professional.map((project) => (
          <CompactEntry
            project={project}
            index={projects.indexOf(project) + 1}
          />
        ))}
      </ol>
    </div>
  )}
</section>

<style>
  .section--work {
    padding-top: clamp(2.25rem, 1.8rem + 2vw, 3rem);
  }

  .section--work :global(.section-head) {
    margin-bottom: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .group {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .group-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  .group-title .name {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 640;
    letter-spacing: -0.015em;
  }

  .index {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
