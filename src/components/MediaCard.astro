---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";

/**
 * A link out to one video or Reel. No embedded player and no remote images:
 * with a local thumbnail it shows the image and a caption; without one it is a
 * typographic 9:16 card.
 */
interface Props {
  item: CollectionEntry<"creative">;
}

const { item } = Astro.props;
const { title, platform, kind, url, thumbnail, alt, year, duration, stat } =
  item.data;
const vertical = kind !== "vlog";
const platformLabel = {
  youtube: "YouTube",
  instagram: "Instagram",
  other: "Video",
}[platform];
const kindLabel = { vlog: "Vlog", reel: "Reel", short: "Short" }[kind];
const meta = [kindLabel, year, duration, stat].filter(Boolean).join(" · ");
const widths = thumbnail
  ? [
      ...(vertical ? [240, 360, 480] : [320, 480, 640, 960]).filter(
        (w) => w < thumbnail.width,
      ),
      thumbnail.width,
    ]
  : [];
---

<li class:list={["media", vertical ? "vertical" : "landscape"]}>
  <a href={url} target="_blank" rel="noopener noreferrer">
    {thumbnail && alt ? (
      <>
        <Picture
          src={thumbnail}
          alt={alt}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          widths={widths}
          sizes={
            vertical
              ? "(min-width: 64rem) 12rem, 10rem"
              : "(min-width: 64rem) 20rem, (min-width: 48rem) 30vw, 78vw"
          }
          loading="lazy"
          decoding="async"
        />
        <span class="caption">
          <span class="label">{meta}</span>
          <span class="title">
            {title}
            <Icon name="arrow-up-right" />
          </span>
        </span>
      </>
    ) : (
      <span class="poster">
        <span class="label">{meta}</span>
        <span class="poster-title">{title}</span>
        <span class="poster-foot mono">
          {platformLabel}
          <Icon name="arrow-up-right" />
        </span>
      </span>
    )}
    <span class="sr-only">(opens {platformLabel} in a new tab)</span>
  </a>
</li>

<style>
  /* Positioned so the hidden "(opens in a new tab)" text stays inside the
     scrolling strip rather than widening the page. */
  .media {
    position: relative;
  }

  .media a {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
  }

  /* Drawn inside the card so the scrolling strip never clips it. */
  .media a:focus-visible {
    outline-offset: -2px;
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color var(--fast) var(--ease);
  }

  .vertical :global(img),
  .poster {
    aspect-ratio: 9 / 16;
  }

  .landscape :global(img) {
    aspect-ratio: 16 / 9;
  }

  .media a:hover :global(img),
  .media a:hover .poster {
    border-color: var(--rule-strong);
  }

  .caption {
    display: grid;
    gap: 0.2rem;
  }

  .title {
    display: inline-flex;
    gap: 0.35rem;
    align-items: baseline;
    font-size: 0.9375rem;
    font-weight: 560;
    line-height: 1.3;
  }

  .media a:hover .title,
  .media a:hover .poster-title {
    color: var(--accent);
  }

  /* Typographic card for Reels without a cover image. */
  .poster {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.75rem;
    padding: 0.9rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color var(--fast) var(--ease);
  }

  .poster-title {
    align-self: end;
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    font-weight: 620;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
    transition: color var(--fast) var(--ease);
  }

  .poster-foot {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }
</style>
