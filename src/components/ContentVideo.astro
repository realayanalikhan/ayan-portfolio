---
import { getCollection, getEntry } from "astro:content";
import { site } from "../data/site";
import DevNote from "./DevNote.astro";
import Icon from "./Icon.astro";
import MediaCard from "./MediaCard.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  number: string;
}

const { number } = Astro.props;
const role = await getEntry("experience", "content-creator");
const items = (await getCollection("creative")).sort(
  (a, b) => a.data.order - b.data.order,
);

const reels = items.filter((item) => item.data.platform === "instagram");
const videos = items.filter((item) => item.data.platform === "youtube");
const reelGroups = [
  { id: "reels-edvoy", label: "Professional work · Edvoy", context: "edvoy" },
  { id: "reels-own", label: "Own work · @realayanalikhan", context: "own" },
]
  .map((group) => ({
    ...group,
    items: reels.filter((item) => item.data.context === group.context),
  }))
  .filter((group) => group.items.length > 0);

const workflow = [
  "Research",
  "Script",
  "Film",
  "Edit",
  "Subtitles & graphics",
  "Review",
  "Publish",
];
---

<section class="section wrap" aria-labelledby="content">
  <SectionHeading
    id="content"
    number={number}
    title="Content & video"
    intro="Alongside software, I make video: professionally at Edvoy, and on my own YouTube vlog series (Hindi, with English subtitles) and Instagram Reels, which I film, present and produce."
  />

  <div class="grid">
    {role && (
      <article class="block" aria-labelledby="edvoy-title">
        <h3 id="edvoy-title">
          {role.data.role}
          {role.data.organisation && (
            <span class="org">, {role.data.organisation}</span>
          )}
        </h3>
        <dl class="facts mono">
          <div>
            <dt class="label">Period</dt>
            <dd>{role.data.period}</dd>
          </div>
          <div>
            <dt class="label">Output</dt>
            <dd>75+ reels</dd>
          </div>
          <div>
            <dt class="label">Platforms</dt>
            <dd>Instagram · YouTube Shorts · Facebook Reels · Snapchat</dd>
          </div>
        </dl>
        <p class="text">{role.data.summary}</p>
        <ul class="list">
          {role.data.highlights.slice(1).map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    )}

    <div class="block workflow">
      <h3>Production workflow</h3>
      <ol class="steps mono">
        {workflow.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p class="text">
        I use AI tools for research, transcription, subtitles and parts of
        post-production, inside a workflow I direct. Every edit is reviewed, and
        corrected where needed, before it is published.
      </p>
    </div>
  </div>

  {items.length > 0 ? (
    <div class="media-sections">
      {reelGroups.length > 0 && (
        <div class="media-block">
          <div class="media-head">
            <h3 id="reels-title">Selected Reels</h3>
            {site.channels.instagram && (
              <a
                class="text-link"
                href={site.channels.instagram}
                target="_blank"
                rel="noopener noreferrer"
              >
                Instagram profile
                <Icon name="arrow-up-right" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            )}
          </div>
          <div class="strip">
            {reelGroups.map((group) => (
              <div class="group">
                <p class="label group-label" id={group.id}>
                  {group.label}
                </p>
                <ul class="reels" aria-labelledby={`reels-title ${group.id}`}>
                  {group.items.map((item) => (
                    <MediaCard item={item} />
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      )}

      {videos.length > 0 && (
        <div class="media-block">
          <div class="media-head">
            <h3 id="youtube-title">Selected YouTube</h3>
            {site.channels.youtube && (
              <a
                class="text-link"
                href={site.channels.youtube}
                target="_blank"
                rel="noopener noreferrer"
              >
                View channel
                <Icon name="arrow-up-right" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            )}
          </div>
          <div class="group">
            <p class="label group-label" id="youtube-own">
              Own work · Ayan Ali Khan
            </p>
            <ul class="videos" aria-labelledby="youtube-title youtube-own">
              {videos.map((item) => (
                <MediaCard item={item} />
              ))}
            </ul>
          </div>
        </div>
      )}
    </div>
  ) : (
    <DevNote text="selected videos and Reels (src/content/creative.yaml)" />
  )}
</section>

<style>
  .grid {
    display: grid;
    gap: 2rem;
  }

  .block {
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule-strong);
  }

  .block h3 {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem);
    font-weight: 620;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .org {
    color: var(--muted);
    font-weight: 500;
  }

  .facts {
    display: grid;
    gap: 0.4rem;
    margin: 0.9rem 0;
  }

  .facts div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
  }

  .facts dd {
    margin: 0;
    color: var(--ink-2);
  }

  .text {
    max-width: 58ch;
    margin-top: 0.75rem;
    color: var(--ink-2);
  }

  .list {
    max-width: 58ch;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .list li {
    position: relative;
    padding-left: 1.1rem;
  }

  .list li + li {
    margin-top: 0.3rem;
  }

  .list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 1px;
    background: var(--accent);
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink-2);
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero) " ";
    color: var(--accent);
  }

  /* Curated media: links out to the originals, no players or feeds. */
  .media-sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    margin-top: 3rem;
  }

  .media-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule-strong);
  }

  .media-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1.5rem;
  }

  .media-head h3 {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem);
    font-weight: 620;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .strip,
  .group {
    min-width: 0;
  }

  .group-label {
    margin-bottom: 0.75rem;
  }

  .reels,
  .videos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Reels: one row of 9:16 cards; it scrolls sideways on narrow screens
     instead of stacking into a tall wall. */
  .strip {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    padding-bottom: 0.75rem;
  }

  .strip > .group {
    flex: none;
  }

  .strip .group + .group {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .reels {
    display: flex;
    gap: 0.75rem;
  }

  .reels > :global(li) {
    flex: none;
    width: 8.75rem;
    scroll-snap-align: start;
  }

  /* YouTube: a sideways row on phones, three columns from tablet up. */
  .videos {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    padding-bottom: 0.75rem;
  }

  .videos > :global(li) {
    flex: none;
    width: min(78vw, 20rem);
    scroll-snap-align: start;
  }

  @media (min-width: 48rem) {
    .reels > :global(li) {
      width: 10rem;
    }

    .videos {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem 1.25rem;
      overflow: visible;
      padding-bottom: 0;
    }

    .videos > :global(li) {
      width: auto;
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
    }

    .media-block {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 2.5rem;
    }

    .media-head {
      flex-direction: column;
      align-items: flex-start;
      align-self: start;
      justify-content: flex-start;
    }
  }

  @media (min-width: 80rem) {
    .media-block {
      grid-template-columns: 14rem minmax(0, 1fr);
    }

    .reels > :global(li) {
      width: 11.5rem;
    }
  }
</style>
