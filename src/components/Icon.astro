---
/** Small inline SVG icon set (decorative; always paired with visible or hidden text). */
interface Props {
  name:
    | "arrow-right"
    | "arrow-left"
    | "arrow-up-right"
    | "arrow-up"
    | "download"
    | "sun"
    | "moon";
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Props["name"], string> = {
  "arrow-right": "M3 8h10M9 4l4 4-4 4",
  "arrow-left": "M13 8H3M7 4 3 8l4 4",
  "arrow-up-right": "M5 11l6-6M6 5h5v5",
  "arrow-up": "M8 13V3M4 7l4-4 4 4",
  download: "M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10",
  sun: "M8 5.25a2.75 2.75 0 1 0 0 5.5 2.75 2.75 0 0 0 0-5.5ZM8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06",
  moon: "M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z",
};
---

<svg
  class:list={["icon", name.startsWith("arrow") && "icon--arrow", className]}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>

<style>
  .icon {
    flex: none;
    width: 1em;
    height: 1em;
  }
</style>
