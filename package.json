{
  "name": "ayan-portfolio",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:public && astro check && astro build && npm run check:public:dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && npm run check:public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:public": "node scripts/check-public-content.mjs",
    "check:public:dist": "node scripts/check-public-content.mjs --dist",
    "check:public:self-test": "node scripts/check-public-content.mjs --self-test",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  }
}
