---
import type { CollectionEntry } from "astro:content";
import { getImage, Picture } from "astro:assets";
import Icon from "./Icon.astro";
import StackList from "./StackList.astro";

/**
 * A client-work entry: no links, figures or status claims. Images are full
 * screenshots with client details redacted, marked `cleared` (enforced by the
 * content schema). They are never cropped and each links to its full-size file.
 * One image is shown as a figure; several as a small scrolling gallery.
 */
interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const {
  title,
  summary,
  system,
  period,
  focus,
  stack,
  responsibilities,
  mobileShowAll,
  images = [],
} = project.data;
const shot = images.length === 1 ? images[0] : undefined;
const tall = shot ? shot.src.height > shot.src.width : false;
const full = shot
  ? await getImage({ src: shot.src, format: "webp", width: shot.src.width })
  : undefined;
const shotWidths = shot
  ? [
      ...(tall ? [240, 360] : [480, 720, 960, 1280]).filter(
        (w) => w < shot.src.width,
      ),
      shot.src.width,
    ]
  : [];

// Several screenshots: a scroll-snap row with previous/next controls. Phone
// screenshots sit side by side; landscape (desktop) ones show one at a time.
const wide =
  images.length > 1 && images.every((i) => i.src.width > i.src.height);
const gallery =
  images.length > 1
    ? await Promise.all(
        images.map(async (image) => ({
          image,
          full: (
            await getImage({
              src: image.src,
              format: "webp",
              width: image.src.width,
            })
          ).src,
          widths: [
            ...(wide ? [480, 720, 960, 1280] : [240, 360]).filter(
              (w) => w < image.src.width,
            ),
            image.src.width,
          ],
        })),
      )
    : [];
---

<li class="row">
  <span class="idx label" aria-hidden="true">
    {String(index).padStart(2, "0")}
  </span>
  <div class="main">
    <p class="tags">
      <span class="label">Client work · details confidential</span>
      {focus && <span class="focus">{focus}</span>}
    </p>
    <h4>{title}</h4>
    <p class="summary">{summary}</p>
    {responsibilities.length > 0 && (
      <ul class:list={["resp", mobileShowAll && "resp--all"]}>
        {responsibilities.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
    <StackList items={stack} />
    {shot && full && (
      <figure class:list={["shot", tall && "shot--tall"]}>
        <a href={full.src} target="_blank" rel="noopener noreferrer">
          <Picture
            src={shot.src}
            alt={shot.alt}
            formats={["avif", "webp"]}
            widths={shotWidths}
            sizes={
              tall
                ? "(min-width: 40rem) 16rem, 13rem"
                : "(min-width: 64rem) 46rem, 100vw"
            }
            loading="lazy"
            decoding="async"
          />
          <span class="sr-only">
            (opens the full-size screenshot in a new tab)
          </span>
        </a>
        {shot.caption && (
          <figcaption class="label">
            {shot.caption} <span aria-hidden="true">Select to enlarge.</span>
          </figcaption>
        )}
      </figure>
    )}
    {gallery.length > 1 && (
      <figure
        class:list={["gallery", wide && "gallery--wide"]}
        data-gallery
        aria-label={`${title}: ${gallery.length} screenshots`}
      >
        <ul class="slides" data-track>
          {gallery.map(({ image, full, widths }, i) => (
            <li class="slide">
              <a href={full} target="_blank" rel="noopener noreferrer">
                <Picture
                  src={image.src}
                  alt={image.alt}
                  formats={["avif", "webp"]}
                  widths={widths}
                  sizes={
                    wide
                      ? "(min-width: 64rem) 46rem, 100vw"
                      : "(min-width: 40rem) 13rem, 11rem"
                  }
                  loading="lazy"
                  decoding="async"
                />
                <span class="sr-only">
                  (screenshot {i + 1} of {gallery.length}, opens full size in a
                  new tab)
                </span>
              </a>
              {image.caption && (
                <p class="label slide-caption">{image.caption}</p>
              )}
            </li>
          ))}
        </ul>
        <div class="controls" data-controls hidden>
          <button
            type="button"
            class="ctl"
            data-prev
            aria-label="Previous screenshot"
          >
            <Icon name="arrow-left" />
          </button>
          <span class="count mono" data-count aria-live="polite">
            1 / {gallery.length}
          </span>
          <button
            type="button"
            class="ctl"
            data-next
            aria-label="Next screenshot"
          >
            <Icon name="arrow-right" />
          </button>
        </div>
        <figcaption class="label">Select a screenshot to enlarge.</figcaption>
      </figure>
    )}
  </div>
  <dl class="meta mono">
    <div>
      <dt class="label">Type</dt>
      <dd>{system}</dd>
    </div>
    <div>
      <dt class="label">Year</dt>
      <dd>{period}</dd>
    </div>
  </dl>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-bottom: 1px solid var(--rule);
  }

  .idx {
    color: var(--muted);
  }

  /* Lets the screenshot gallery scroll inside the column instead of widening it. */
  .main {
    min-width: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
  }

  .focus {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h4 {
    margin-top: 0.6rem;
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
    font-weight: 630;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .summary {
    max-width: 62ch;
    margin-top: 0.5rem;
    color: var(--ink-2);
  }

  .resp {
    max-width: 62ch;
    margin: 0.75rem 0 0.9rem;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .resp li {
    position: relative;
    padding-left: 1.1rem;
  }

  .resp li + li {
    margin-top: 0.3rem;
  }

  .resp li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 1px;
    background: var(--muted);
  }

  /* The whole screenshot, never cropped: only its display size is limited. */
  .shot {
    max-width: 46rem;
    margin: 1.25rem 0 0;
  }

  .shot--tall {
    max-width: 13rem;
  }

  .shot a {
    position: relative;
    display: block;
    cursor: zoom-in;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color var(--fast) var(--ease);
  }

  .shot a:hover :global(img) {
    border-color: var(--rule-strong);
  }

  .shot figcaption {
    margin-top: 0.5rem;
  }

  @media (min-width: 40rem) {
    .shot--tall {
      max-width: 16rem;
    }
  }

  /* Gallery: a row of complete screenshots that scrolls sideways when it does
     not fit. Controls appear only when there is something to scroll to. */
  .gallery {
    max-width: 46rem;
    margin: 1.25rem 0 0;
  }

  .slides {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
  }

  .slide {
    flex: none;
    width: 11rem;
    scroll-snap-align: start;
  }

  .slide a {
    position: relative;
    display: block;
    cursor: zoom-in;
  }

  /* Drawn inside the image so the scrolling row never clips it. */
  .slide a:focus-visible {
    outline-offset: -2px;
  }

  .slide :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color var(--fast) var(--ease);
  }

  .slide a:hover :global(img) {
    border-color: var(--rule-strong);
  }

  .slide-caption {
    margin-top: 0.4rem;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .controls[hidden] {
    display: none;
  }

  .ctl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      background var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .ctl:hover:not(:disabled) {
    background: var(--ink);
    color: var(--paper);
  }

  .ctl:disabled {
    border-color: var(--rule);
    color: var(--muted);
    cursor: default;
  }

  .count {
    min-width: 3.5rem;
    color: var(--ink-2);
    text-align: center;
  }

  .gallery figcaption {
    margin-top: 0.5rem;
  }

  @media (min-width: 40rem) {
    .slide {
      width: 13rem;
    }
  }

  /* Landscape screenshots: one full-width slide at a time. */
  .gallery--wide .slide {
    width: 100%;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0;
  }

  .meta div {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .meta dd {
    margin: 0;
    color: var(--ink-2);
  }

  /* Mobile: keep the two most important responsibilities, and drop the type/year
     details, which the summary and the group heading already state. */
  @media (max-width: 39.99rem) {
    .resp:not(.resp--all) li:nth-child(n + 3) {
      display: none;
    }

    .meta {
      display: none;
    }

    .resp {
      margin-bottom: 0.75rem;
    }
  }

  @media (min-width: 64rem) {
    .row {
      grid-template-columns: 3.5rem minmax(0, 1fr) 15rem;
      column-gap: 2rem;
    }

    .idx {
      padding-top: 0.2rem;
    }

    .meta {
      flex-direction: column;
      gap: 0.9rem;
    }

    .meta div {
      display: block;
    }

    .meta dd {
      margin-top: 0.15rem;
    }
  }
</style>

<script>
  // Previous/next and "1 / 3" for screenshot galleries. Without this script
  // the row still scrolls (swipe, trackpad, keyboard) and every image works.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const gallery of document.querySelectorAll<HTMLElement>(
    "[data-gallery]",
  )) {
    const track = gallery.querySelector<HTMLElement>("[data-track]")!;
    const slides = [...track.children] as HTMLElement[];
    const controls = gallery.querySelector<HTMLElement>("[data-controls]")!;
    const count = gallery.querySelector<HTMLElement>("[data-count]")!;
    const prev = gallery.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = gallery.querySelector<HTMLButtonElement>("[data-next]")!;
    const offset = (i: number) => slides[i].offsetLeft - slides[0].offsetLeft;
    const atEnd = () =>
      track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;

    // While a button-triggered scroll is animating, count from its target so
    // repeated presses each move one slide.
    let target: number | null = null;
    let settle = 0;

    const current = () => {
      if (target !== null) return target;
      if (atEnd()) return slides.length - 1;
      let index = 0;
      slides.forEach((_, i) => {
        if (offset(i) <= track.scrollLeft + 4) index = i;
      });
      return index;
    };

    const update = () => {
      controls.hidden = track.scrollWidth <= track.clientWidth + 1;
      count.textContent = `${current() + 1} / ${slides.length}`;
      // A button that becomes disabled while focused would drop keyboard
      // focus to the page, so hand focus to the other button first.
      const focused = document.activeElement;
      const atStart = track.scrollLeft <= 1;
      const end = atEnd();
      if (atStart && focused === prev && !end) next.focus();
      if (end && focused === next && !atStart) prev.focus();
      prev.disabled = atStart;
      next.disabled = end;
    };

    const go = (step: number) => {
      const i = Math.min(slides.length - 1, Math.max(0, current() + step));
      target = i;
      window.clearTimeout(settle);
      settle = window.setTimeout(() => {
        target = null;
        update();
      }, 700);
      count.textContent = `${i + 1} / ${slides.length}`;
      track.scrollTo({
        left: offset(i),
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    };

    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
    track.addEventListener("scroll", () => requestAnimationFrame(update), {
      passive: true,
    });
    new ResizeObserver(update).observe(track);
    update();
  }
</script>
