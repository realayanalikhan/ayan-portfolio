---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

/** A figure for case studies. Only rendered for approved images supplied in the content. */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  number: number;
}

const { src, alt, caption, number } = Astro.props;
---

<figure class="case-figure">
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    widths={[640, 960, 1280, 1600]}
    sizes="(min-width: 64rem) 46rem, 100vw"
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    <span class="label">Figure {number}</span>
    {caption && <span>{caption}</span>}
  </figcaption>
</figure>

<style>
  .case-figure {
    margin: 0;
  }

  .case-figure :global(img) {
    width: 100%;
    height: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
