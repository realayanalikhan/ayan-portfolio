---
import { contactLinks } from "../data/site";
import DevNote from "./DevNote.astro";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  number: string;
}

const { number } = Astro.props;
// The section lists email only. LinkedIn and GitHub stay in site data for the
// structured data (sameAs) but are not shown here.
const links = contactLinks().filter((link) => link.label === "Email");
---

{links.length > 0 ? (
  <section class="section wrap" aria-labelledby="contact">
    <SectionHeading id="contact" number={number} title="Contact" />
    <ul class="links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            {...(link.external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <span class="label-text">{link.label}</span>
            <span class="detail">{link.detail}</span>
            <Icon name={link.external ? "arrow-up-right" : "arrow-right"} />
            {link.external && <span class="sr-only">(opens in a new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
) : (
  <div class="wrap">
    <DevNote text="contact email, LinkedIn and GitHub URLs (src/data/site.ts); the Contact section is hidden until set" />
  </div>
)}

<style>
  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-strong);
  }

  .links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.15rem 1rem;
    min-height: 4.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
    font-size: clamp(1.375rem, 1.1rem + 1.4vw, 2.5rem);
    font-weight: 620;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }

  .links a:hover {
    color: var(--accent);
  }

  .links a :global(.icon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 0.75em;
    height: 0.75em;
  }

  /* The address or handle: monospace, so it reads as something to copy. */
  .detail {
    grid-column: 1;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }

  .links a:hover .detail {
    color: inherit;
  }

  @media (min-width: 48rem) {
    .links a {
      grid-template-columns: minmax(0, 1fr) auto auto;
      column-gap: 2rem;
    }

    .detail {
      grid-column: 2;
      grid-row: 1;
      font-size: 0.9375rem;
    }

    .links a :global(.icon) {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
